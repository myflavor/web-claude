# =============================================================================
# Claude Mobile configuration
# Copy to .env  (never commit real keys)
# =============================================================================

# --- Web UI login (required) ---
AUTH_TOKEN=please-change-this-to-a-long-random-string

# Listen address
LISTEN_ADDR=:8080

# -----------------------------------------------------------------------------
# Run mode
#   auto   - detect docker vs native (default)
#   native - WSL / bare metal: use your real ~/.claude and system claude
#   docker - isolated /data/home + /data/projects (set automatically in compose)
# -----------------------------------------------------------------------------
# RUN_MODE=native

# -----------------------------------------------------------------------------
# Native / WSL (recommended defaults — often leave these unset)
# -----------------------------------------------------------------------------
# Directory browser root (default: ~/projects if exists, else current dir)
# PROJECTS_ROOT=/home/you/code
#
# Leave CLAUDE_HOME / HOME_DIR empty to use your real user HOME and existing
# ~/.claude/settings.json (plugins, model, permissions, history).
# CLAUDE_HOME=
# HOME_DIR=
# CLAUDE_BIN=claude

# -----------------------------------------------------------------------------
# Docker / NAS (compose sets these; host paths below map into the container)
# -----------------------------------------------------------------------------
PROJECTS_HOST_PATH=./data/projects
# Host dir mounted as container HOME → container sees ~/.claude here
CLAUDE_HOME_HOST_PATH=./data/home
# HOME_HOST_PATH=./data/home   # alias, still supported

# Put your Claude settings on the host at:
#   ./data/home/.claude/settings.json
# or bind-mount your real config:
#   CLAUDE_HOME_HOST_PATH=/home/you   (then settings are at /home/you/.claude)

# -----------------------------------------------------------------------------
# Custom Anthropic-compatible API (optional if already in settings/env)
# -----------------------------------------------------------------------------
ANTHROPIC_BASE_URL=https://your-api.example.com
ANTHROPIC_AUTH_TOKEN=sk-xxx
# ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_MODEL=your-model-id
ANTHROPIC_DEFAULT_SONNET_MODEL=your-model-id
ANTHROPIC_DEFAULT_OPUS_MODEL=your-model-id
ANTHROPIC_DEFAULT_HAIKU_MODEL=your-model-id

# Optional
# CLAUDE_ARGS=
# IDLE_TTL_HOURS=24
# COOKIE_SECURE=false
